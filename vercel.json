{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/workspace", "destination": "https://propdata.proptechusa.ai/dashboard", "permanent": false},
    {"source": "/dashboard", "destination": "https://propdata.proptechusa.ai/dashboard", "permanent": false}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ]
}
